# Makefile for Typus with proper locale settings

.PHONY: test test-production build clean

# Set locale to avoid warnings
export LC_ALL=C
export LANG=C
export LC_CTYPE=C
export LC_MESSAGES=C
export LC_COLLATE=C

# Default target
test:
	cabal test --flags="-fast production" --test-show-details=direct

# Production test with all warnings enabled
test-production:
	cabal clean
	cabal test --flags="-fast production werror" --test-show-details=direct

# Build with all warnings
build:
	cabal build --flags="-fast production" --ghc-options="-Wall -Wextra -Werror"

# Clean build artifacts
clean:
	cabal clean

# Install dependencies
deps:
	cabal update
	cabal build --dependencies-only

# Run with locale fix
test-with-locale:
	LC_ALL=C LANG=C LC_CTYPE=C LC_MESSAGES=C LC_COLLATE=C cabal test --flags="-fast production" --test-show-details=direct