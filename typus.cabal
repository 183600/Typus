cabal-version: 2.2
name:          typus
version:       0.9.0
synopsis:      Typus compiler with dependent types and ownership analysis
description:   A compiler for the Typus language with support for dependent types and ownership analysis
license:       MIT
author:        Typus Development Team
maintainer:    dev@typus.example.com
category:      Compilers, Language
build-type:    Simple
extra-doc-files: ChangeLog.md
extra-source-files:
    test/fixtures/full_project/*.typus
    test/fixtures/full_project/assets/hello.txt

source-repository head
  type: git
  location: https://gitee.com/qwe12345678/typus.git

common warnings
    ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wpartial-fields -Wredundant-constraints -Wmissing-export-lists -Wmissing-home-modules -Wmonomorphism-restriction -Wmissing-signatures -Wname-shadowing -Worphans -Wpartial-type-signatures -Wtabs -Wtype-defaults -Wunrecognised-pragmas -Wunused-do-bind -Wunused-foralls -Wunused-imports -Wunused-matches -Wunused-top-binds -Wunused-type-patterns -Wwarn=deprecations -Wwarn=unused-imports -Wwarn=unused-matches -Wwarn=unused-local-binds -Wwarn=unused-top-binds -Wwarn=unused-type-patterns
    if flag(werror)
        ghc-options: -Werror

library
    import:           warnings
    hs-source-dirs:   src
    exposed-modules:
        AnalyzerIntegration,
        Analyzer.DependentTypeBridge,
        Analyzer.State,
        Analyzer.SymbolTable,
        Analyzer.Types,
        Cli,
        CommandLineDebug,
        Compiler,
        Compiler.Errors,
        Compiler.Errors.Core,
        Compiler.GoAst,
        Compiler.ValueAnalysis,
        CompilerUtils,
        Debug,
        DebugIntegration,
        Dependencies,
        Dependencies.AST,
        Dependencies.TypeSystem,
        DependentTypesParser,
        EmbedAssets,
        GoToolchain,
        IntegratedCompiler,
        Ownership,
        Parser,
        SimpleSyntaxValidator,
        SourceLocation,
        SyntaxValidator,
        Tooling.Error,
        Utils
    other-modules:
        Compiler.Error,
        Compiler.GoLexer,
        Compiler.GoParsing,
        Compiler.GoVarSpec,
        Compiler.IR,
        Compiler.DependentTypeChecker,
        Compiler.OwnershipChecker,
        Compiler.TypeChecker,
        Compiler.Errors.Compiler,
        Analyzer.OwnershipBridge,
        Analyzer.CrossAnalysis,
        ErrorHandler,
        EnhancedErrorHandler,
        Dependencies.Parser,
        Dependencies.Analyzer,
        Dependencies.Inference,
        Ownership.Common.Lexer,
        Ownership.Common.Types,
        Ownership.Lexer,
        Ownership.Parser,
        Ownership.Analyzer,
        Ownership.Reporter
    build-depends:
        base >=4.7 && <5,
        aeson >= 2.2 && <3,
        containers >= 0.6 && <1,
        mtl >= 2.2 && <3,
        parsec >= 3.1.0 && <3.2,
        megaparsec >= 9.0.0 && <10,
        parser-combinators >= 1.3.0 && <2,
        text >= 1.2.0 && <3,
        directory >= 1.3.0 && <2,
        filepath >= 1.4.0 && <2,
        Glob >= 0.10 && <1,
        process >= 1.6.0 && <2,
        regex-tdfa >= 1.3.0 && <2,
        optparse-applicative >= 0.16.0 && <1,
        temporary >= 1.2 && <2,
        time >= 1.8 && <2,
        old-time >= 1.1 && <2
    default-language: Haskell2010

executable typus
    import:           warnings
    main-is:          Main.hs
    build-depends:
        base >=4.7 && <5,
        typus,
        containers,
        mtl,
        parsec >= 3.1.0,
        directory >= 1.3.0,
        filepath >= 1.4.0,
        process >= 1.6.0,
        temporary >= 1.2,
        Glob >= 0.10 && <1
    hs-source-dirs:   app
    default-language: Haskell2010
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N

-- Consolidate tests: keep only the canonical test-suite as the production gate

-- Fast/Full test flags
flag fast
    description: Run only fast tests by default
    default:     False

flag full
    description: Include slow/integration/perf tests
    default:     False

-- Production testing flags
flag production
    description: Enable production-grade testing with strict requirements
    default:     True

flag coverage
    description: Enable test coverage generation
    default:     True

flag werror
    description: Treat warnings as errors
    default:     True
    manual:      True

-- REMOVED: Redundant test executables
--
-- The following executables have been removed as they are redundant with the
-- comprehensive test-suite typus-test:
--   - parser-test (redundant with Test.Unit.ParserSpec)
--   - compiler-test (redundant with Test.Unit.CompilerSpec)
--   - minimal-compiler-test (redundant with Test.Unit.CompilerSpec)
--   - typus-compilation-test (redundant with Test.Integration.PipelineSpec)
--
-- All testing should now be done via:
--   cabal test                              (run all tests)
--   cabal test --flag typus:fast            (fast tests only)
--   cabal test --flag typus:full            (comprehensive tests)
--   cabal test --flag typus:production      (production-ready tests)
--   cabal test --flag typus:coverage        (with coverage)
--
-- This consolidation reduces maintenance costs and ensures all tests use
-- the same infrastructure (Tasty framework) with consistent reporting.
--
-- Original test files remain in app/ for historical reference but are no
-- longer built by default.

-- Benchmark suite for performance testing
benchmark typus-bench
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          BenchmarkRunner.hs
    hs-source-dirs:   test
    other-modules:
        BenchmarkTests
    build-depends:
        base >=4.7 && <5,
        typus,
        containers,
        mtl,
        parsec >= 3.1.0,
        directory >= 1.3.0,
        filepath >= 1.4.0,
        criterion >= 1.6,
        deepseq >= 1.4.0
    default-language: Haskell2010
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N

-- Canonical test-suite
test-suite typus-test
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    hs-source-dirs:   test
    default-extensions: NoMonomorphismRestriction
    other-modules:
        Test.Dependencies.Arbitrary,
        Test.Golden,
        Test.Golden.Tests,
        Test.Golden.CompilerSpec,
        Test.Integration,
        Test.Integration.Tests,
        Test.Integration.PipelineSpec,
        Test.Integration.AnalyzerSpec,
        Test.Integration.IntegratedCompilerSpec,
        Test.Integration.FullProjectSpec,
        Test.Unit,
        Test.Unit.Tests,
        Test.Unit.CLISpec,
        Test.Unit.CompilerSpec,
        Test.Unit.DependentTypesSpec,
        Test.Unit.ErrorHandlingSpec,
        Test.Unit.OwnershipSpec,
        Test.Unit.ParserSpec,
        Test.Unit.TypeSystemSpec,
        Test.Unit.SymbolTableSpec,
        Test.Unit.ValueAnalysisSpec
    build-depends:
        base >=4.7 && <5,
        typus,
        containers,
        mtl,
        parsec >= 3.1.0,
        directory >= 1.3.0,
        filepath >= 1.4.0,
        process >= 1.6.0,
        HUnit >= 1.6.0,
        deepseq >= 1.4.0,
        time >= 1.8.0,
        tasty >= 1.4,
        tasty-hunit >= 0.10,
        tasty-golden >= 2.3,
        tasty-quickcheck >= 0.10,
        criterion >= 1.6,
        QuickCheck >= 2.14,
        async >= 2.2,
        stm >= 2.5,
        Glob >= 0.10 && <1,
        temporary >= 1.2 && <2,
        time >= 1.8 && <2,
        text >= 1.2.0 && <3,
        hpc >= 0.7,
        bytestring >= 0.10 && <1,
        transformers >= 0.5 && <0.7
    default-language: Haskell2010
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N -with-rtsopts=-M4G -Wno-unused-top-binds -Wno-unused-local-binds -Wno-unused-matches
    if flag(fast)
        cpp-options:   -DFAST_TESTS
    if flag(full)
        cpp-options:   -DFULL_TESTS
    if flag(production)
        cpp-options:   -DPRODUCTION_TESTS
        ghc-options:   -threaded -with-rtsopts=-N -with-rtsopts=-M8G -Werror
    else
        ghc-options:   -fno-warn-unused-imports -fno-warn-unused-matches -fno-warn-unused-binds -fno-warn-unused-top-binds -fno-warn-unused-type-patterns -fno-warn-missing-signatures -Wno-name-shadowing -Wno-missing-export-lists -Wno-compat-unqualified-imports -Wno-type-defaults -Wno-misplaced-pragmas -Wno-monomorphism-restriction
    if flag(coverage)
        ghc-options:   -fhpc -fno-warn-unused-imports -fno-warn-unused-matches -fno-warn-unused-binds -fno-warn-unused-top-binds -fno-warn-unused-type-patterns

