-- Enhanced Memory-Optimized Test Suite with advanced memory management
test-suite typus-test-enhanced
    type:             exitcode-stdio-1.0
    build-tool-depends: typus:typus
    main-is:          EnhancedMemoryTestRunner.hs
    hs-source-dirs:   test
    default-extensions: NoMonomorphismRestriction
    ghc-options:      -Wall -Wcompat
                      -Wno-unused-top-binds -Wno-unused-matches 
                      -Wno-orphans -Wno-name-shadowing
                      -Wno-type-defaults -Wno-unused-local-binds
                      -Wno-unused-imports
                      -rtsopts
                      -O0
    other-modules:
        Test.Unit.BasicQuickCheckTestSuite
        Test.Unit.SimpleQuickCheckTestSuite
        Test.Unit.ConciseTestSuite
        Test.Unit.ExtendedQuickCheckTestSuiteOptimized
        Test.Unit.ComprehensiveMemoryOptimizedTestSuite
        Test.Unit.AdvancedMemoryOptimizedTestSuite
        Test.Unit.Exact200QuickCheckTestsOptimized
        Test.Unit.Exactly200QuickCheckTestsOptimized
        Test.Unit.Final200QuickCheckTestsOptimized
        Test.Unit.FinalExact200QuickCheckTestsOptimized
        Test.Unit.True200QuickCheckTestsOptimized
        TestSupport.EnhancedMemoryOptimization
        TestSupport.MemoryEfficientGenerators
        TestSupport.MemoryLimits
        TestSupport.OptimizedMemoryLimits
        TestSupport.UnifiedMemoryOptimization
        TestSupport.EnhancedMemoryMonitor
        TestSupport.ExtremeMemoryOptimization
        TestSupport.SmartTestSelector
        TestSupport.Arbitrary
    build-depends:
            base >=4.7 && <5,
            typus,
            tasty >= 1.4 && <2,
            tasty-quickcheck >= 0.10 && <1,
            tasty-hunit >= 0.10 && <1,
            QuickCheck >= 2.14 && <3,
            text >= 1.2.0 && <3,
            directory >= 1.3.0 && <2,
            time >= 1.8 && <2,
            deepseq >= 1.4 && <2,
            containers >= 0.6 && <1,
            megaparsec >= 9.0.0 && <10,
            mtl >= 2.2 && <3,
            unix,
            process
    default-language: Haskell2010
        
executable typus
    import:           warnings
    main-is:          Main.hs
    build-depends:
        base >=4.7 && <5,
        typus
    hs-source-dirs:   app
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N

-- Test Debug executable for debugging specific test cases
executable test-debug
    import:           warnings
    main-is:          TestDebug7.hs
    build-depends:
        base >=4.7 && <5,
        typus
    hs-source-dirs:   test/debug/app_debug
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N

-- Smart Memory Test Runner for optimized testing with memory constraints
executable smart-memory-test-runner
    import:           warnings
    main-is:          SmartMemoryTestRunner.hs
    hs-source-dirs:   test
    other-modules:
        TestSupport.SmartTestSelector,
        TestSupport.AdaptiveMemoryConfig,
        Test.Unit.CoreUtilsQuickCheckTests,
        Test.Unit.ParserQuickCheckTests,
        Test.Unit.CompilerCoreQuickCheckTests,
        Test.Unit.DependencyAnalysisQuickCheckTests,
        Test.Unit.OwnershipAnalysisQuickCheckTests,
        Test.Unit.ErrorHandlingQuickCheckTests,
        TestSupport.MemoryLimits,
        TestSupport.UnifiedMemoryOptimization
    build-depends:
        base >=4.7 && <5,
        typus,
        tasty >= 1.4 && <2,
        tasty-quickcheck >= 0.10 && <1,
        tasty-hunit >= 0.10 && <1,
        QuickCheck >= 2.14 && <3,
        text >= 1.2.0 && <3,
        directory >= 1.3.0 && <2,
        time >= 1.8 && <2,
        deepseq >= 1.4 && <2,
        containers >= 0.6 && <1,
        megaparsec >= 9.0.0 && <10,
        mtl >= 2.2 && <3,
        process >= 1.6.0 && <2
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N

-- Consolidate tests: keep only the canonical test-suite as the production gate

-- Fast/Full test flags
flag fast
    description: Enable fast test mode by default (disable to run comprehensive suites)
    default:     True

flag full
    description: Include slow/integration/perf tests
    default:     False

-- Production testing flags
flag production
    description: Enable production-grade testing with strict requirements
    default:     False

-- Coverage is now enabled via --enable-coverage configure flag

flag werror
    description: Treat warnings as errors
    default:     False
    manual:      True

-- REMOVED: Redundant test executables
--
-- The following executables have been removed as they are redundant with the
-- comprehensive test-suite typus-test:
--   - parser-test (redundant with Test.Unit.ParserSpec)
--   - compiler-test (redundant with Test.Unit.CompilerSpec)
--   - minimal-compiler-test (redundant with Test.Unit.CompilerSpec)
--   - typus-compilation-test (redundant with Test.Integration.PipelineSpec)
--
-- All testing should now be done via:
--   cabal test                              (fast unit tests only; default behaviour)
--   cabal test --flags="-fast full"         (comprehensive tests)
--   cabal test --flags="-fast production"   (production-ready tests)
--   cabal test --flag typus:coverage        (with coverage)
--
-- This consolidation reduces maintenance costs and ensures all tests use
-- the same infrastructure (Tasty framework) with consistent reporting.
--
-- Original test files remain in app/ for historical reference but are no
-- longer built by default.

