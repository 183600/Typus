cabal-version: 2.2
name:          typus
version:       0.12.0
synopsis:      Typus compiler with dependent types and ownership analysis
description:   A compiler for the Typus language with support for dependent types and ownership analysis
license:       MIT
author:        Typus Development Team
maintainer:    dev@typus.example.com
category:      Compilers, Language
build-type:    Simple
extra-doc-files: docs/ChangeLog.md
extra-source-files:
    test/fixtures/full_project/*.typus
    test/fixtures/full_project/assets/hello.txt
    test/golden/fixtures/*.go
    test/data/*.typus

source-repository head
  type: git
  location: https://gitee.com/qwe12345678/typus.git

common warnings
    ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wpartial-fields -Wredundant-constraints -Wmissing-export-lists -Wmissing-home-modules -Wmonomorphism-restriction -Wmissing-signatures -Wname-shadowing -Worphans -Wpartial-type-signatures -Wtabs -Wtype-defaults -Wunrecognised-pragmas -Wunused-do-bind -Wunused-foralls -Wunused-imports -Wunused-matches -Wunused-top-binds -Wunused-type-patterns -Wdeprecations
    if flag(werror)
        ghc-options: -Werror

library
    import:           warnings
    hs-source-dirs:   src
    exposed-modules:
        AnalyzerIntegration,
        Analyzer.DependentTypeBridge,
        Analyzer.OwnershipBridge,
        Analyzer.State,
        Analyzer.SymbolTable,
        Analyzer.Types,
        Cli,
        Cli.DebugRunner,
        Cli.Runner,
        CommandLineDebug,
        Compiler,
        Compiler.DependentTypeChecker,
        Compiler.Errors,
        Compiler.Errors.Core,
        Compiler.GoAst,
        Compiler.GoLexer,
        Compiler.GoParsing,
        Compiler.IR,
        Compiler.TypeChecker,
        Compiler.ValueAnalysis,
        Ownership.Common.Lexer,
        Ownership.Parser,
        CompilerUtils,
        Debug,
        DebugIntegration,
        Dependencies,
        Dependencies.AST,
        Dependencies.Analyzer,
        Dependencies.Inference,
        Dependencies.Parser,
        Dependencies.TypeSystem,
        DependentTypesParser,
        EmbedAssets,
        EnhancedDebug,
        ErrorHandler,
        EnhancedErrorHandler,
        GoToolchain,
        IntegratedCompiler,
        Ownership,
        Ownership.Common.Types,
        Parser,
        SimpleSyntaxValidator,
        SourceLocation,
        SyntaxValidator,
        Tooling.Error,
        Utils
    other-modules:
        Compiler.Error,
        Compiler.GoVarSpec,
        Compiler.OwnershipChecker,
        Compiler.Errors.Compiler,
        Analyzer.CrossAnalysis,
        Ownership.Lexer,
        Ownership.Analyzer,
        Ownership.Reporter
    build-depends:
        base >=4.7 && <5,
        aeson >= 2.2 && <3,
        containers >= 0.6 && <1,
        mtl >= 2.2 && <3,
        megaparsec >= 9.0.0 && <10,
        text >= 1.2.0 && <3,
        directory >= 1.3.0 && <2,
        filepath >= 1.4.0 && <2,
        Glob >= 0.10 && <1,
        process >= 1.6.0 && <2,
        optparse-applicative >= 0.16.0 && <1,
        temporary >= 1.2 && <2,
        random >= 1.1 && <2,
        time >= 1.8 && <2,
        deepseq >= 1.4 && <2
    default-language: Haskell2010

executable typus
    import:           warnings
    main-is:          Main.hs
    build-depends:
        base >=4.7 && <5,
        typus
    hs-source-dirs:   app
    default-language: Haskell2010
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N

-- Consolidate tests: keep only the canonical test-suite as the production gate

-- Fast/Full test flags
flag fast
    description: Enable fast test mode by default (disable to run comprehensive suites)
    default:     True

flag full
    description: Include slow/integration/perf tests
    default:     False

-- Production testing flags
flag production
    description: Enable production-grade testing with strict requirements
    default:     False

-- Coverage is now enabled via --enable-coverage configure flag

flag werror
    description: Treat warnings as errors
    default:     False
    manual:      True

-- REMOVED: Redundant test executables
--
-- The following executables have been removed as they are redundant with the
-- comprehensive test-suite typus-test:
--   - parser-test (redundant with Test.Unit.ParserSpec)
--   - compiler-test (redundant with Test.Unit.CompilerSpec)
--   - minimal-compiler-test (redundant with Test.Unit.CompilerSpec)
--   - typus-compilation-test (redundant with Test.Integration.PipelineSpec)
--
-- All testing should now be done via:
--   cabal test                              (fast unit tests only; default behaviour)
--   cabal test --flags="-fast full"         (comprehensive tests)
--   cabal test --flags="-fast production"   (production-ready tests)
--   cabal test --flag typus:coverage        (with coverage)
--
-- This consolidation reduces maintenance costs and ensures all tests use
-- the same infrastructure (Tasty framework) with consistent reporting.
--
-- Original test files remain in app/ for historical reference but are no
-- longer built by default.

-- Benchmark suite for performance testing
benchmark typus-bench
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          BenchmarkRunner.hs
    hs-source-dirs:   test
    other-modules:
        BenchmarkTests
    build-depends:
        base >=4.7 && <5,
        typus,
        containers,
        mtl,
        directory >= 1.3.0,
        filepath >= 1.4.0,
        criterion >= 1.6,
        deepseq >= 1.4.0
    default-language: Haskell2010
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N

-- Canonical test-suite
test-suite typus-test
    type:             exitcode-stdio-1.0
    build-tool-depends: typus:typus
    main-is:          Main.hs
    hs-source-dirs:   test
    default-extensions: NoMonomorphismRestriction
    ghc-options:      -Wall -Wcompat
                      -Wno-unused-top-binds -Wno-unused-matches 
