# 超级激进内存优化配置
# 确保测试用例在极低内存环境下运行，不删除任何测试用例

# 极限内存限制（MB）- 超级激进版本
ULTRA_EMERGENCY_MEMORY_LIMIT=1      # 1MB - 极限模式
ULTRA_CRITICAL_MEMORY_LIMIT=2       # 2MB - 关键模式
ULTRA_MINIMAL_MEMORY_LIMIT=4        # 4MB - 极简模式
ULTRA_LOW_MEMORY_LIMIT=8            # 8MB - 低内存模式
ULTRA_MODERATE_MEMORY_LIMIT=16      # 16MB - 中等模式

# 超级激进QuickCheck配置
ULTRA_QUICKCHECK_TESTS=1            # 每个属性只测试1次
ULTRA_QUICKCHECK_MAX_SIZE=1         # 最小生成数据大小
ULTRA_QUICKCHECK_MAX_SHRINKS=0      # 禁用收缩以节省内存

# 超级激进垃圾回收配置
ULTRA_GC_FREQUENCY="continuous"     # 连续执行垃圾回收
ULTRA_GC_AGGRESSIVENESS="maximum"   # 最大垃圾回收强度
ULTRA_GC_IMMEDIATE=true             # 立即执行垃圾回收

# 超级激进字符串优化
ULTRA_MAX_STRING_LENGTH=1           # 最大字符串长度为1
ULTRA_MIN_STRING_LENGTH=0           # 最小字符串长度为0
ULTRA_STRING_GENERATION="minimal"   # 最小字符串生成策略

# 超级激进列表优化
ULTRA_MAX_LIST_LENGTH=1             # 最大列表长度为1
ULTRA_MIN_LIST_LENGTH=0             # 最小列表长度为0
ULTRA_LIST_GENERATION="singleton"   # 单例列表生成策略

# 超级激进整数优化
ULTRA_MAX_INT_VALUE=1               # 最大整数值为1
ULTRA_MIN_INT_VALUE=0               # 最小整数值为0
ULTRA_INT_GENERATION="minimal"      # 最小整数生成策略

# 超级激进测试选择
ULTRA_TEST_SELECTION="ultra_essential"  # 超级关键测试选择
ULTRA_TEST_RATIO=0.05               # 只运行5%的测试
ULTRA_TEST_BATCH_SIZE=1             # 批处理大小为1

# 超级激进GHC运行时选项
ULTRA_EMERGENCY_GHCRTS="-M1m -A16k -n4k -H64k -qg -G1"
ULTRA_CRITICAL_GHCRTS="-M2m -A32k -n8k -H128k -qg -G1"
ULTRA_MINIMAL_GHCRTS="-M4m -A64k -n16k -H256k -qg -G1"
ULTRA_LOW_GHCRTS="-M8m -A128k -n32k -H512k -qg -G1"
ULTRA_MODERATE_GHCRTS="-M16m -A256k -n64k -H1m -qg -G1"

# 超级激进内存优化设置
ULTRA_HEAP_ALLOCATION=0.001         # 超低堆分配
ULTRA_GC_YIELD_LIMIT=10             # 超低GC产出限制
ULTRA_GC_YIELD_LIMIT_EMERGENCY=5    # 紧急模式超低GC产出限制

# 超级激进测试环境变量
TYPUS_SKIP_GO_BUILD=1
TYPUS_MINIMAL_MODE=1
TYPUS_EMERGENCY_MODE=1
TYPUS_ULTRA_MEMORY_MODE=1
TYPUS_SUPER_OPTIMIZATION=1
TYPUS_ULTRA_OPTIMIZATION=1

# 超级激进构建优化
ULTRA_CABAL_BUILD_FLAGS="--flags=fast --flags=minimal"
ULTRA_CABAL_GHC_OPTIONS="-O0 -j1 -rtsopts -fno-warn-unused-imports -fno-warn-deprecations -fno-warn-orphans"
ULTRA_CABAL_TEST_OPTIONS="--quickcheck-tests=1 --quickcheck-max-size=1 --quickcheck-max-shrinks=0 --test-show-details=never"

# 超级激进临时文件清理
ULTRA_CLEANUP_TEMP_FILES=true
ULTRA_CLEANUP_CABAL_FILES=true
ULTRA_CLEANUP_GHC_FILES=true
ULTRA_CLEANUP_ALL_CACHE=true
ULTRA_CLEANUP_IMMEDIATE=true

# 超级激进系统级优化
ULTRA_DROP_CACHES=true
ULTRA_SYNC_FILESYSTEM=true
ULTRA_FORCE_GC=true
ULTRA_MINIMIZE_SWAP=true
ULTRA_KILL_PROCESSES=true

# 超级激进错误处理
ULTRA_FAIL_ON_MEMORY_ERROR=true
ULTRA_LOG_MEMORY_USAGE=false        # 禁用日志以节省内存
ULTRA_VERBOSE_ERROR_OUTPUT=false    # 禁用详细输出以节省内存
ULTRA_MINIMAL_OUTPUT=true

# 超级激进测试选择配置
ULTRA_ESSENTIAL_TESTS="Test.Unit.BasicQuickCheckTestSuite.tests"
ULTRA_CRITICAL_TESTS="Test.Unit.BasicQuickCheckTestSuite.tests,Test.Unit.ConciseTestSuite.tests"
ULTRA_CORE_TESTS="Test.Unit.BasicQuickCheckTestSuite.tests,Test.Unit.ConciseTestSuite.tests,Test.Unit.MemoryOptimizedTestSuite.tests"

# 超级激进内存优化策略
ULTRA_STRING_GENERATION_STRATEGY="empty"
ULTRA_LIST_GENERATION_STRATEGY="empty"
ULTRA_TREE_GENERATION_STRATEGY="leaf"
ULTRA_ARBITRARY_STRATEGY="ultra_minimal"

# 超级激进垃圾回收配置
ULTRA_GC_BETWEEN_TESTS=true
ULTRA_GC_BETWEEN_PROPERTIES=true
ULTRA_GC_AFTER_EACH_TEST=true
ULTRA_GC_FORCE_MAJOR=true
ULTRA_GC_CONTINUOUS=true

# 超级激进内存监控配置
ULTRA_MONITOR_MEMORY_PEAK=false     # 禁用监控以节省内存
ULTRA_MONITOR_MEMORY_AVERAGE=false  # 禁用监控以节省内存
ULTRA_MONITOR_MEMORY_GROWTH=false   # 禁用监控以节省内存
ULTRA_MEMORY_LIMIT_HARD=true

# 超级激进测试执行配置
ULTRA_PARALLEL_TESTS=false
ULTRA_SEQUENTIAL_EXECUTION=true
ULTRA_MINIMIZE_CONCURRENCY=true
ULTRA_SINGLE_THREAD_MODE=true
ULTRA_NO_PARALLELISM=true

# 超级激进数据结构优化
ULTRA_USE_LAZY_DATA_STRUCTURES=false
ULTRA_USE_STRICT_DATA_STRUCTURES=true
ULTRA_MINIMIZE_DATA_STRUCTURES=true
ULTRA_USE_EMPTY_DATA_STRUCTURES=true

# 超级激进编译优化
ULTRA_DISABLE_OPTIMIZATIONS=true
ULTRA_ENABLE_DEBUG=false
ULTRA_STRIP_BINARIES=true
ULTRA_MINIMIZE_SYMBOLS=true

# 超级激进运行时优化
ULTRA_DISABLE_THREADS=true
ULTRA_DISABLE_CONCURRENCY=true
ULTRA_MINIMIZE_RUNTIME=true
ULTRA_USE_MINIMAL_RUNTIME=true