// Complex ownership patterns
func complexOwnership() {
    a := []int{1}
    {
        b := a
        {
            c := &b
            fmt.Println(*c)
        }
    }
}

// Shadowing with same name
func shadowing() {
    x := 1
    {
        x := 2
        {
            x := 3
            fmt.Println(x)
        }
    }
}

// Type inference edge cases
func inferComplex() {
    var x  // Should infer type
    x = 42
    
    y := func() int {
        return 10
    }
}

