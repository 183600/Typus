{-# LANGUAGE OverloadedStrings #-}

-- | 统一的极度内存优化测试运行器
-- 整合所有内存优化技术，确保测试用例不会消耗大量内存
module TestSupport.UnifiedExtremeMemoryTestRunner 
  ( -- 主运行器
    runExtremeMemoryTests
  , runAdaptiveMemoryTests
  , runConfigurableMemoryTests
  
    -- 测试配置
    ExtremeTestConfig(..)
  , createExtremeTestConfig
  , loadExtremeTestConfig
  , saveExtremeTestConfig
  
    -- 测试套件构建
    buildExtremeTestSuite
    , buildAdaptiveTestSuite
    , buildMinimalTestSuite
  
    -- 内存管理
    ExtremeMemoryManager(..)
  , createExtremeMemoryManager
  , withExtremeMemoryManagement
  , monitorAndAdjustMemory
  
    -- 测试执行
    ExtremeTestExecutor(..)
  , createExtremeTestExecutor
  , executeWithMemoryOptimization
  , executeBatchWithMemoryControl
  ) where

