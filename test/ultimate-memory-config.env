# 极致内存优化配置
# 提供比现有配置更激进的内存优化策略

# 极致内存限制（MB）- 比现有配置更激进
ULTIMATE_EMERGENCY_MEMORY_LIMIT=1      # 1MB - 极致紧急
ULTIMATE_CRITICAL_MEMORY_LIMIT=2       # 2MB - 极致关键
ULTIMATE_MINIMAL_MEMORY_LIMIT=4        # 4MB - 极致最小
ULTIMATE_LOW_MEMORY_LIMIT=8            # 8MB - 极度低内存
ULTIMATE_MODERATE_MEMORY_LIMIT=16      # 16MB - 极度适中
ULTIMATE_NORMAL_MEMORY_LIMIT=32        # 32MB - 极度正常

# 极致QuickCheck配置 - 更激进的参数
ULTIMATE_EMERGENCY_QUICKCHECK_TESTS=1
ULTIMATE_CRITICAL_QUICKCHECK_TESTS=1
ULTIMATE_MINIMAL_QUICKCHECK_TESTS=1
ULTIMATE_LOW_QUICKCHECK_TESTS=2
ULTIMATE_MODERATE_QUICKCHECK_TESTS=3
ULTIMATE_NORMAL_QUICKCHECK_TESTS=5

ULTIMATE_EMERGENCY_QUICKCHECK_MAX_SIZE=1
ULTIMATE_CRITICAL_QUICKCHECK_MAX_SIZE=1
ULTIMATE_MINIMAL_QUICKCHECK_MAX_SIZE=2
ULTIMATE_LOW_QUICKCHECK_MAX_SIZE=2
ULTIMATE_MODERATE_QUICKCHECK_MAX_SIZE=3
ULTIMATE_NORMAL_QUICKCHECK_MAX_SIZE=5

ULTIMATE_EMERGENCY_QUICKCHECK_MAX_SHRINKS=0
ULTIMATE_CRITICAL_QUICKCHECK_MAX_SHRINKS=0
ULTIMATE_MINIMAL_QUICKCHECK_MAX_SHRINKS=0
ULTIMATE_LOW_QUICKCHECK_MAX_SHRINKS=1
ULTIMATE_MODERATE_QUICKCHECK_MAX_SHRINKS=1
ULTIMATE_NORMAL_QUICKCHECK_MAX_SHRINKS=2

# 极致GHC运行时选项 - 更激进的设置
ULTIMATE_EMERGENCY_GHCRTS="-M1m -A32k -n4k -H128k -qg -G1 -c"
ULTIMATE_CRITICAL_GHCRTS="-M2m -A64k -n8k -H256k -qg -G1 -c"
ULTIMATE_MINIMAL_GHCRTS="-M4m -A128k -n16k -H512k -qg -G1 -c"
ULTIMATE_LOW_GHCRTS="-M8m -A256k -n32k -H1m -qg -G1"
ULTIMATE_MODERATE_GHCRTS="-M16m -A512k -n64k -H2m -qg -G1"
ULTIMATE_NORMAL_GHCRTS="-M32m -A1m -n128k -H4m -qg -G1"

# 极致内存优化设置
ULTIMATE_GHC_HEAP_ALLOCATION=0.001      # 更激进的堆分配限制
ULTIMATE_GHC_GC_YIELD_LIMIT=50          # 更频繁的GC
ULTIMATE_GHC_GC_YIELD_LIMIT_EMERGENCY=25 # 极致环境下的GC限制

# 极致测试选择 - 更精细的控制
ULTIMATE_EMERGENCY_TEST_SELECTION="ultra-essential"
ULTIMATE_CRITICAL_TEST_SELECTION="essential-core"
ULTIMATE_MINIMAL_TEST_SELECTION="core-basic"
ULTIMATE_LOW_TEST_SELECTION="basic-standard"
ULTIMATE_MODERATE_TEST_SELECTION="standard-enhanced"
ULTIMATE_NORMAL_TEST_SELECTION="enhanced-comprehensive"

# 极致垃圾回收策略
ULTIMATE_EMERGENCY_GC_STRATEGY="ultra-aggressive"
ULTIMATE_CRITICAL_GC_STRATEGY="hyper-aggressive"
ULTIMATE_MINIMAL_GC_STRATEGY="aggressive"
ULTIMATE_LOW_GC_STRATEGY="frequent"
ULTIMATE_MODERATE_GC_STRATEGY="regular"
ULTIMATE_NORMAL_GC_STRATEGY="normal"

# 极致测试超时（秒）- 更短的超时
ULTIMATE_EMERGENCY_TEST_TIMEOUT=15
ULTIMATE_CRITICAL_TEST_TIMEOUT=30
ULTIMATE_MINIMAL_TEST_TIMEOUT=60
ULTIMATE_LOW_TEST_TIMEOUT=120
ULTIMATE_MODERATE_TEST_TIMEOUT=300
ULTIMATE_NORMAL_TEST_TIMEOUT=600

# 极致内存监控 - 更频繁的监控
ULTIMATE_ENABLE_MEMORY_MONITORING=true
ULTIMATE_MEMORY_CHECK_INTERVAL=200        # 更频繁的检查
ULTIMATE_MEMORY_CLEANUP_THRESHOLD=0.7    # 更低的清理阈值
ULTIMATE_MEMORY_EMERGENCY_THRESHOLD=0.9  # 紧急阈值

# 极致字符串长度限制 - 更严格的限制
ULTIMATE_EMERGENCY_MAX_STRING_LENGTH=1
ULTIMATE_CRITICAL_MAX_STRING_LENGTH=1
ULTIMATE_MINIMAL_MAX_STRING_LENGTH=2
ULTIMATE_LOW_MAX_STRING_LENGTH=3
ULTIMATE_MODERATE_MAX_STRING_LENGTH=5
ULTIMATE_NORMAL_MAX_STRING_LENGTH=8

# 极致列表长度限制 - 更严格的限制
ULTIMATE_EMERGENCY_MAX_LIST_LENGTH=1
ULTIMATE_CRITICAL_MAX_LIST_LENGTH=1
ULTIMATE_MINIMAL_MAX_LIST_LENGTH=1
ULTIMATE_LOW_MAX_LIST_LENGTH=2
ULTIMATE_MODERATE_MAX_LIST_LENGTH=3
ULTIMATE_NORMAL_MAX_LIST_LENGTH=5

# 极致整数范围限制 - 更严格的限制
ULTIMATE_EMERGENCY_MAX_INT_VALUE=1
ULTIMATE_CRITICAL_MAX_INT_VALUE=2
ULTIMATE_MINIMAL_MAX_INT_VALUE=3
ULTIMATE_LOW_MAX_INT_VALUE=5
ULTIMATE_MODERATE_MAX_INT_VALUE=8
ULTIMATE_NORMAL_MAX_INT_VALUE=16

# 极致测试环境变量
ULTIMATE_TYPUS_SKIP_GO_BUILD=1
ULTIMATE_TYPUS_MINIMAL_MODE=1
ULTIMATE_TYPUS_EMERGENCY_MODE=0
ULTIMATE_TYPUS_ULTRA_OPTIMIZATION=1
ULTIMATE_TYPUS_EXTREME_LIMITS=1

# 极致构建优化
ULTIMATE_CABAL_BUILD_FLAGS="--flags=fast --disable-profiling --disable-documentation"
ULTIMATE_CABAL_GHC_OPTIONS="-O0 -j1 -rtsopts -fno-warn-unused-imports -fno-warn-unused-matches -fno-warn-name-shadowing -fno-warn-type-defaults -fno-warn-missing-signatures"
ULTIMATE_CABAL_TEST_OPTIONS="--quickcheck-tests=1 --quickcheck-max-size=1 --quickcheck-max-shrinks=0 --test-count=1"

# 极致临时文件清理
ULTIMATE_CLEANUP_TEMP_FILES=true
ULTIMATE_CLEANUP_CABAL_FILES=true
ULTIMATE_CLEANUP_GHC_FILES=true
ULTIMATE_CLEANUP_STACK_FILES=true
ULTIMATE_CLEANUP_DIST_FILES=true

# 极致系统级优化
ULTIMATE_DROP_CACHES=true
ULTIMATE_SYNC_FILESYSTEM=true
ULTIMATE_FORCE_GC=true
ULTIMATE_COMPRESS_MEMORY=true

# 极致错误处理
ULTIMATE_FAIL_ON_MEMORY_ERROR=true
ULTIMATE_LOG_MEMORY_USAGE=true
ULTIMATE_VERBOSE_ERROR_OUTPUT=true
ULTIMATE_STRICT_MEMORY_LIMITS=true

# 极致并行控制
ULTIMATE_MAX_PARALLEL_TESTS=1           # 禁用并行测试
ULTIMATE_SEQUENTIAL_EXECUTION=true      # 强制顺序执行
ULTIMATE_ISOLATE_TEST_PROCESSES=true    # 隔离测试进程

# 极致数据结构优化
ULTIMATE_USE_LAZY_EVALUATION=false      # 禁用惰性求值
ULTIMATE_USE_STRICT_EVALUATION=true     # 启用严格求值
ULTIMATE_MINIMIZE_THUNKS=true           # 最小化thunk
ULTIMATE_FORCE_EVALUATION=true          # 强制求值

# 极致内存分配策略
ULTIMATE_SMALL_OBJECT_THRESHOLD=64      # 小对象阈值
ULTIMATE_MEDIUM_OBJECT_THRESHOLD=256    # 中等对象阈值
ULTIMATE_LARGE_OBJECT_THRESHOLD=1024    # 大对象阈值
ULTIMATE_COMPACT_ALLOCATION=true        # 紧凑分配

# 极致缓存策略
ULTIMATE_DISABLE_CACHING=true           # 禁用缓存
ULTIMATE_CLEAR_CACHE_BETWEEN_TESTS=true # 测试间清理缓存
ULTIMATE_MINIMIZE_CACHE_SIZE=1          # 最小化缓存大小

# 极致监控和报告
ULTIMATE_DETAILED_MEMORY_REPORTING=true # 详细内存报告
ULTIMATE_REAL_TIME_MONITORING=true      # 实时监控
ULTIMATE_MEMORY_PROFILING=false         # 禁用内存分析（节省内存）
ULTIMATE_PERFORMANCE_COUNTERS=true      # 性能计数器

# 极致测试选择器配置
ULTIMATE_ESSENTIAL_TEST_PATTERNS="trim|split|basic|core"
ULTIMATE_CORE_TEST_PATTERNS="trim|split|string|list|basic|core"
ULTIMATE_STANDARD_TEST_PATTERNS="trim|split|string|list|memory|optimized|basic|core"
ULTIMATE_ENHANCED_TEST_PATTERNS=".*"     # 所有测试（仅在最高级别）

# 极致环境自适应
ULTIMATE_AUTO_DETECT_MEMORY=true
ULTIMATE_AUTO_ADJUST_LIMITS=true
ULTIMATE_AUTO_SCALE_TESTS=true
ULTIMATE_AUTO_OPTIMIZE_GHC=true

# 极致恢复策略
ULTIMATE_ENABLE_MEMORY_RECOVERY=true
ULTIMATE_RECOVERY_CLEANUP_LEVEL="aggressive"
ULTIMATE_MAX_RECOVERY_ATTEMPTS=3
ULTIMATE_RECOVERY_TIMEOUT=30

# 极致调试和诊断
ULTIMATE_ENABLE_MEMORY_DIAGNOSTICS=false  # 默认禁用以节省内存
ULTIMATE_DEBUG_MEMORY_ALLOCATION=false   # 默认禁用以节省内存
ULTIMATE_TRACK_MEMORY_LEAKS=false        # 默认禁用以节省内存
ULTIMATE_VERBOSE_GC_OUTPUT=false          # 默认禁用以节省内存