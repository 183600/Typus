# 极简内存优化配置
# 专注于最小化内存使用而不删除测试用例

# 基本内存限制（MB）
EMERGENCY_MEMORY_LIMIT=2
CRITICAL_MEMORY_LIMIT=4
MINIMAL_MEMORY_LIMIT=8
LOW_MEMORY_LIMIT=16
MODERATE_MEMORY_LIMIT=32

# QuickCheck 配置
EMERGENCY_QUICKCHECK_TESTS=1
CRITICAL_QUICKCHECK_TESTS=1
MINIMAL_QUICKCHECK_TESTS=1
LOW_QUICKCHECK_TESTS=2
MODERATE_QUICKCHECK_TESTS=3

EMERGENCY_QUICKCHECK_MAX_SIZE=1
CRITICAL_QUICKCHECK_MAX_SIZE=1
MINIMAL_QUICKCHECK_MAX_SIZE=1
LOW_QUICKCHECK_MAX_SIZE=2
MODERATE_QUICKCHECK_MAX_SIZE=3

EMERGENCY_QUICKCHECK_MAX_SHRINKS=0
CRITICAL_QUICKCHECK_MAX_SHRINKS=0
MINIMAL_QUICKCHECK_MAX_SHRINKS=0
LOW_QUICKCHECK_MAX_SHRINKS=1
MODERATE_QUICKCHECK_MAX_SHRINKS=2

# GHC 运行时选项
EMERGENCY_GHCRTS="-M2m -A128k -n16k -H512k -qg -G1"
CRITICAL_GHCRTS="-M4m -A256k -n32k -H1m -qg -G1"
MINIMAL_GHCRTS="-M8m -A512k -n64k -H2m -qg -G1"
LOW_GHCRTS="-M16m -A1m -n128k -H4m -qg -G1"
MODERATE_GHCRTS="-M32m -A2m -n256k -H8m -qg -G1"

# 内存优化设置
GHC_HEAP_ALLOCATION=0.01
GHC_GC_YIELD_LIMIT=200
GHC_GC_YIELD_LIMIT_EMERGENCY=100

# 测试选择
EMERGENCY_TEST_SELECTION="essential"
CRITICAL_TEST_SELECTION="core"
MINIMAL_TEST_SELECTION="basic"
LOW_TEST_SELECTION="standard"
MODERATE_TEST_SELECTION="comprehensive"

# 垃圾回收策略
EMERGENCY_GC_STRATEGY="aggressive"
CRITICAL_GC_STRATEGY="aggressive"
MINIMAL_GC_STRATEGY="frequent"
LOW_GC_STRATEGY="regular"
MODERATE_GC_STRATEGY="normal"

# 测试超时（秒）
EMERGENCY_TEST_TIMEOUT=30
CRITICAL_TEST_TIMEOUT=60
MINIMAL_TEST_TIMEOUT=120
LOW_TEST_TIMEOUT=300
MODERATE_TEST_TIMEOUT=600

# 内存监控
ENABLE_MEMORY_MONITORING=true
MEMORY_CHECK_INTERVAL=500
MEMORY_CLEANUP_THRESHOLD=0.8

# 字符串长度限制
EMERGENCY_MAX_STRING_LENGTH=1
CRITICAL_MAX_STRING_LENGTH=2
MINIMAL_MAX_STRING_LENGTH=3
LOW_MAX_STRING_LENGTH=5
MODERATE_MAX_STRING_LENGTH=8

# 列表长度限制
EMERGENCY_MAX_LIST_LENGTH=1
CRITICAL_MAX_LIST_LENGTH=1
MINIMAL_MAX_LIST_LENGTH=2
LOW_MAX_LIST_LENGTH=3
MODERATE_MAX_LIST_LENGTH=5

# 整数范围限制
EMERGENCY_MAX_INT_VALUE=2
CRITICAL_MAX_INT_VALUE=3
MINIMAL_MAX_INT_VALUE=5
LOW_MAX_INT_VALUE=10
MODERATE_MAX_INT_VALUE=20

# 测试环境变量
TYPUS_SKIP_GO_BUILD=1
TYPUS_MINIMAL_MODE=1
TYPUS_EMERGENCY_MODE=0

# 构建优化
CABAL_BUILD_FLAGS="--flags=fast"
CABAL_GHC_OPTIONS="-O0 -j1 -rtsopts"
CABAL_TEST_OPTIONS="--quickcheck-tests=1 --quickcheck-max-size=1 --quickcheck-max-shrinks=0"

# 临时文件清理
CLEANUP_TEMP_FILES=true
CLEANUP_CABAL_FILES=true
CLEANUP_GHC_FILES=true

# 系统级优化
DROP_CACHES=true
SYNC_FILESYSTEM=true
FORCE_GC=true

# 错误处理
FAIL_ON_MEMORY_ERROR=true
LOG_MEMORY_USAGE=true
VERBOSE_ERROR_OUTPUT=true