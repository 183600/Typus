# 超级内存优化配置
# 确保测试用例在极低内存环境下运行，不删除任何测试用例

# 基本内存限制（MB）- 超级优化版本
SUPER_EMERGENCY_MEMORY_LIMIT=1
SUPER_CRITICAL_MEMORY_LIMIT=2
SUPER_MINIMAL_MEMORY_LIMIT=4
SUPER_LOW_MEMORY_LIMIT=8
SUPER_MODERATE_MEMORY_LIMIT=16

# 超级QuickCheck配置
SUPER_EMERGENCY_QUICKCHECK_TESTS=1
SUPER_CRITICAL_QUICKCHECK_TESTS=1
SUPER_MINIMAL_QUICKCHECK_TESTS=1
SUPER_LOW_QUICKCHECK_TESTS=1
SUPER_MODERATE_QUICKCHECK_TESTS=1

SUPER_EMERGENCY_QUICKCHECK_MAX_SIZE=1
SUPER_CRITICAL_QUICKCHECK_MAX_SIZE=1
SUPER_MINIMAL_QUICKCHECK_MAX_SIZE=1
SUPER_LOW_QUICKCHECK_MAX_SIZE=1
SUPER_MODERATE_QUICKCHECK_MAX_SIZE=2

SUPER_EMERGENCY_QUICKCHECK_MAX_SHRINKS=0
SUPER_CRITICAL_QUICKCHECK_MAX_SHRINKS=0
SUPER_MINIMAL_QUICKCHECK_MAX_SHRINKS=0
SUPER_LOW_QUICKCHECK_MAX_SHRINKS=0
SUPER_MODERATE_QUICKCHECK_MAX_SHRINKS=1

# 超级GHC运行时选项
SUPER_EMERGENCY_GHCRTS="-M1m -A32k -n4k -H128k -qg -G1"
SUPER_CRITICAL_GHCRTS="-M2m -A64k -n8k -H256k -qg -G1"
SUPER_MINIMAL_GHCRTS="-M4m -A128k -n16k -H512k -qg -G1"
SUPER_LOW_GHCRTS="-M8m -A256k -n32k -H1m -qg -G1"
SUPER_MODERATE_GHCRTS="-M16m -A512k -n64k -H2m -qg -G1"

# 超级内存优化设置
GHC_HEAP_ALLOCATION=0.001
GHC_GC_YIELD_LIMIT=50
GHC_GC_YIELD_LIMIT_EMERGENCY=10

# 超级测试选择
SUPER_EMERGENCY_TEST_SELECTION="ultra_essential"
SUPER_CRITICAL_TEST_SELECTION="critical_only"
SUPER_MINIMAL_TEST_SELECTION="core_only"
SUPER_LOW_TEST_SELECTION="basic_only"
SUPER_MODERATE_TEST_SELECTION="essential_only"

# 超级垃圾回收策略
SUPER_EMERGENCY_GC_STRATEGY="continuous"
SUPER_CRITICAL_GC_STRATEGY="continuous"
SUPER_MINIMAL_GC_STRATEGY="ultra_aggressive"
SUPER_LOW_GC_STRATEGY="aggressive"
SUPER_MODERATE_GC_STRATEGY="frequent"

# 超级测试超时（秒）
SUPER_EMERGENCY_TEST_TIMEOUT=10
SUPER_CRITICAL_TEST_TIMEOUT=20
SUPER_MINIMAL_TEST_TIMEOUT=30
SUPER_LOW_TEST_TIMEOUT=60
SUPER_MODERATE_TEST_TIMEOUT=120

# 超级内存监控
ENABLE_SUPER_MEMORY_MONITORING=true
SUPER_MEMORY_CHECK_INTERVAL=100
SUPER_MEMORY_CLEANUP_THRESHOLD=0.5

# 超级字符串长度限制
SUPER_EMERGENCY_MAX_STRING_LENGTH=1
SUPER_CRITICAL_MAX_STRING_LENGTH=1
SUPER_MINIMAL_MAX_STRING_LENGTH=2
SUPER_LOW_MAX_STRING_LENGTH=3
SUPER_MODERATE_MAX_STRING_LENGTH=5

# 超级列表长度限制
SUPER_EMERGENCY_MAX_LIST_LENGTH=1
SUPER_CRITICAL_MAX_LIST_LENGTH=1
SUPER_MINIMAL_MAX_LIST_LENGTH=1
SUPER_LOW_MAX_LIST_LENGTH=2
SUPER_MODERATE_MAX_LIST_LENGTH=3

# 超级整数范围限制
SUPER_EMERGENCY_MAX_INT_VALUE=1
SUPER_CRITICAL_MAX_INT_VALUE=2
SUPER_MINIMAL_MAX_INT_VALUE=3
SUPER_LOW_MAX_INT_VALUE=5
SUPER_MODERATE_MAX_INT_VALUE=10

# 超级测试环境变量
TYPUS_SKIP_GO_BUILD=1
TYPUS_MINIMAL_MODE=1
TYPUS_EMERGENCY_MODE=1
TYPUS_SUPER_MEMORY_MODE=1
TYPUS_ULTRA_OPTIMIZATION=1

# 超级构建优化
CABAL_BUILD_FLAGS="--flags=fast --flags=minimal"
CABAL_GHC_OPTIONS="-O0 -j1 -rtsopts -fno-warn-unused-imports -fno-warn-deprecations"
CABAL_TEST_OPTIONS="--quickcheck-tests=1 --quickcheck-max-size=1 --quickcheck-max-shrinks=0 --test-show-details=never"

# 超级临时文件清理
CLEANUP_TEMP_FILES=true
CLEANUP_CABAL_FILES=true
CLEANUP_GHC_FILES=true
CLEANUP_ALL_CACHE=true

# 超级系统级优化
DROP_CACHES=true
SYNC_FILESYSTEM=true
FORCE_GC=true
MINIMIZE_SWAP=true

# 超级错误处理
FAIL_ON_MEMORY_ERROR=true
LOG_MEMORY_USAGE=true
VERBOSE_ERROR_OUTPUT=false
MINIMAL_OUTPUT=true

# 超级测试选择配置
SUPER_ESSENTIAL_TESTS="Test.Unit.BasicQuickCheckTestSuite.tests,Test.Unit.ConciseTestSuite.tests,Test.Unit.MemoryOptimizedTestSuite.tests"
SUPER_CRITICAL_TESTS="Test.Unit.BasicQuickCheckTestSuite.tests,Test.Unit.ConciseTestSuite.tests,Test.Unit.MemoryOptimizedTestSuite.tests,Test.Unit.ExtremeMemoryOptimizedTestSuite.tests"
SUPER_CORE_TESTS="Test.Unit.BasicQuickCheckTestSuite.tests,Test.Unit.ConciseTestSuite.tests,Test.Unit.MemoryOptimizedTestSuite.tests,Test.Unit.ExtremeMemoryOptimizedTestSuite.tests,Test.Unit.AdvancedMemoryOptimizedTestSuite.tests"

# 超级内存优化策略
SUPER_STRING_GENERATION_STRATEGY="minimal"
SUPER_LIST_GENERATION_STRATEGY="singleton"
SUPER_TREE_GENERATION_STRATEGY="shallow"
SUPER_ARBITRARY_STRATEGY="ultra_minimal"

# 超级垃圾回收配置
SUPER_GC_BETWEEN_TESTS=true
SUPER_GC_BETWEEN_PROPERTIES=true
SUPER_GC_AFTER_EACH_TEST=true
SUPER_GC_FORCE_MAJOR=true

# 超级内存监控配置
SUPER_MONITOR_MEMORY_PEAK=true
SUPER_MONITOR_MEMORY_AVERAGE=true
SUPER_MONITOR_MEMORY_GROWTH=true
SUPER_MEMORY_LIMIT_HARD=true

# 超级测试执行配置
SUPER_PARALLEL_TESTS=false
SUPER_SEQUENTIAL_EXECUTION=true
SUPER_MINIMIZE_CONCURRENCY=true
SUPER_SINGLE_THREAD_MODE=true