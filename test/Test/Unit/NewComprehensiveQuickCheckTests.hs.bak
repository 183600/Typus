-- Test Suite
-- ============================================================================

tests :: TestTree
tests = testGroup "New Comprehensive QuickCheck Tests"
  [ testGroup "Parser Tests"
    [ fastProperty "valid identifier parsing" prop_valid_identifier_parsing
    , fastProperty "empty code block valid" prop_empty_code_block_valid
    , fastProperty "file directives parsing" prop_file_directives_parsing
    , fastProperty "block directives parsing" prop_block_directives_parsing
    , fastProperty "nested code blocks" prop_nested_code_blocks
    , memoryEfficientProperty "string escape roundtrip" prop_string_escape_roundtrip
    , fastProperty "valid Go snippets" prop_valid_go_snippets
    ]
  , testGroup "Compiler Tests"
    [ fastProperty "empty file compiles" prop_empty_file_compiles
    , fastProperty "simple function compiles" prop_simple_function_compiles
    , memoryEfficientProperty "generated Go syntax" prop_generated_go_syntax
    , fastProperty "compilation phases order" prop_compilation_phases_order
    , fastProperty "error messages useful" prop_error_messages_useful
    ]
  , testGroup "Ownership Tests"
    [ fastProperty "new analyzer valid state" prop_new_analyzer_valid_state
    , fastProperty "ownership transfer valid" prop_ownership_transfer_valid
    , fastProperty "ownership use after move" prop_ownership_use_after_move
    , fastProperty "borrowing rules enforced" prop_borrowing_rules_enforced
    , memoryEfficientProperty "ownership graph consistent" prop_ownership_graph_consistent
    ]
  , testGroup "Dependencies Tests"
    [ fastProperty "new type system valid" prop_new_type_system_valid
    , fastProperty "type inference deterministic" prop_type_inference_deterministic
    , memoryEfficientProperty "constraint solving preserves validity" prop_constraint_solving_preserves_validity
    , fastProperty "type environment consistent" prop_type_environment_consistent
    , fastProperty "dependency cycle detection" prop_dependency_cycle_detection
    ]
  , testGroup "Source Location Tests"
    [ fastProperty "source positions valid" prop_source_positions_valid
    , fastProperty "source spans valid" prop_source_spans_valid
    , fastProperty "span merge valid" prop_span_merge_valid
    , fastProperty "span length correct" prop_span_length_correct
    ]
  , testGroup "Utils Tests"
    [ fastProperty "string trimming" prop_string_trimming
    , fastProperty "split join inverse" prop_split_join_inverse
    , fastProperty "valid identifier check" prop_valid_identifier_check
    , fastProperty "sanitized identifier valid" prop_sanitized_identifier_valid
    ]
  , testGroup "Integration Tests"
    [ memoryEfficientProperty "full pipeline preserves semantics" prop_full_pipeline_preserves_semantics
    , fastProperty "error recovery valid state" prop_error_recovery_valid_state
    , memoryEfficientProperty "incremental analysis consistent" prop_incremental_analysis_consistent
    ]
  ]