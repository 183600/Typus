-- ============================================================================
-- Parser Tests
-- ============================================================================

-- | Property: Valid identifiers should be parsed correctly
prop_valid_identifier_parsing :: String -> Property
prop_valid_identifier_parsing s = 
  let isValid = all isIdentifierChar s && not (null s) && not (isKeyword s)
      isKeyword x = x `elem` ["func", "type", "var", "if", "else", "for", "while", "return", "import", "package"]
  in if isValid
      then property $ isRight $ parseExpression s
      else property True -- Skip invalid identifiers

-- | Property: Empty code blocks should be valid
prop_empty_code_block_valid :: Property
prop_empty_code_block_valid = 
  let emptySpan = SourceSpan (SourcePos 1 1 0) (SourcePos 1 1 0)
      defaultBlockDirectives = BlockDirectives Nothing Nothing Nothing
      block = CodeBlock defaultBlockDirectives "" emptySpan
  in property $ isRight $ parseTypusFile (TypusFile defaultFileDirectives [] [block] [])

-- | Property: File directives should be parsed correctly
prop_file_directives_parsing :: FileDirectives -> Property
prop_file_directives_parsing directives = 
  let emptySpan = SourceSpan (SourcePos 1 1 0) (SourcePos 1 1 0)
      defaultBlockDirectives = BlockDirectives Nothing Nothing Nothing
      block = CodeBlock defaultBlockDirectives "" emptySpan
      typusFile = TypusFile directives [] [block] []
  in property $ isRight $ parseTypusFile typusFile

-- | Property: Block directives should be parsed correctly
prop_block_directives_parsing :: BlockDirectives -> Property
prop_block_directives_parsing directives = 
  let emptySpan = SourceSpan (SourcePos 1 1 0) (SourcePos 1 1 0)
      block = CodeBlock directives "" emptySpan
      typusFile = TypusFile defaultFileDirectives [] [block] []
  in property $ isRight $ parseTypusFile typusFile

-- | Property: Nested code blocks should maintain structure
prop_nested_code_blocks :: [CodeBlock] -> Property
prop_nested_code_blocks blocks = 
  let typusFile = TypusFile defaultFileDirectives [] blocks []
  in property $ isRight $ parseTypusFile typusFile

-- | Property: String literals should be properly escaped/unescaped
prop_string_escape_roundtrip :: String -> Property
prop_string_escape_roundtrip s = 
  let escaped = escapeString s
      unescaped = unescapeString escaped
  in property $ s == unescaped

-- | Property: Valid Go code snippets should pass basic validation
prop_valid_go_snippets :: String -> Property
prop_valid_go_snippets code = 
  let isGoCode = any (`isInfixOf` code) ["func ", "package ", "import ", "var ", "const "]
  in whenGoCode $ property $ 
    if isGoCode
      then isRight $ parseTypus code
      else property True -- Skip non-Go code
  where
    whenGoCode = guard isGoCode

-- ============================================================================
-- Compiler Tests
-- ============================================================================

-- | Property: Empty Typus files should compile without errors
prop_empty_file_compiles :: Property
prop_empty_file_compiles = 
  let emptyFile = TypusFile defaultFileDirectives [] [] []
  in property $ not $ hasTypeErrors $ compile emptyFile

-- | Property: Simple function declarations should compile
prop_simple_function_compiles :: String -> Property
prop_simple_function_compiles funcName = 
  let isValidName = isValidIdentifier funcName && not (null funcName)
  in whenValid $ property $ 
    if isValidName
      then let code = "func " ++ funcName ++ "() {}"
               result = parseTypus code
           in case result of
                Left _ -> property True -- Skip invalid parsing
                Right typusFile -> not $ hasTypeErrors $ compile typusFile
      else property True
  where
    whenValid = guard isValidName

-- | Property: Generated Go code should be syntactically valid
prop_generated_go_syntax :: TypusFile -> Property
prop_generated_go_syntax typusFile = 
  let goCode = generateGoCode $ compile typusFile
      -- Basic syntax checks for Go code
      hasValidPackage = "package " `isInfixOf` goCode
      hasBalancedBraces = count '{' goCode == count '}' goCode
      hasBalancedParens = count '(' goCode == count ')' goCode
  in property $ hasValidPackage && hasBalancedBraces && hasBalancedParens
  where
    count c = length . filter (== c)

-- | Property: Compilation phases should be in correct order
prop_compilation_phases_order :: TypusFile -> Property
prop_compilation_phases_order typusFile = 
  let result = compile typusFile
      phases = [LexingPhase, ParsingPhase, TypeCheckingPhase, 
                OwnershipAnalysisPhase, DependentTypeCheckingPhase, 
                CodeGenerationPhase, OptimizationPhase]
      phaseIndices = map (\phase -> (phase, getPhaseIndex result phase)) phases
      isOrdered = all (\(i1, i2) -> i1 <= i2) $ zip (map snd phaseIndices) (tail $ map snd phaseIndices)
  in property $ isOrdered
  where
    getPhaseIndex result phase = 
      case findPhaseInResult result phase of
        Just idx -> idx
        Nothing -> -1
    findPhaseInResult _ _ = Nothing -- Simplified for this example

-- | Property: Error messages should contain useful information
prop_error_messages_useful :: TypusFile -> Property
prop_error_messages_useful typusFile = 
  let result = compile typusFile
      errors = formatCompilerErrors result
      hasErrorInfo = not $ null errors
      errorsHaveLocation = all (hasLocationInfo) errors
  in property $ not hasErrorInfo || errorsHaveLocation
  where
    hasLocationInfo error = 
      any (`isInfixOf` error) ["line", "column", "at", "position"]

-- ============================================================================
-- Ownership Tests
-- ============================================================================

-- | Property: New ownership analyzer should be in valid initial state
prop_new_analyzer_valid_state :: Property
prop_new_analyzer_valid_state = 
  let analyzer = newOwnershipAnalyzer
      hasNoErrors = not $ hasOwnershipErrors analyzer
      hasValidState = True -- Additional state checks could be added
  in property $ hasNoErrors && hasValidState

-- | Property: Ownership transfer should follow valid rules
prop_ownership_transfer_valid :: OwnershipTransfer -> Property
prop_ownership_transfer_valid transfer = 
  let analyzer = newOwnershipAnalyzer
      canTransfer = canTransferOwnership analyzer transfer
      result = if canTransfer 
                 then transferOwnership analyzer transfer
                 else analyzer
      transferValid = validateOwnershipConstraints result
  in property $ not canTransfer || transferValid

-- | Property: Ownership analysis should detect use-after-move
prop_ownership_use_after_move :: String -> Property
prop_ownership_use_after_move varName = 
  let isValidName = isValidIdentifier varName && not (null varName)
  in whenValid $ property $ 
    if isValidName
      then let code = varName ++ " := 1\n" ++ varName ++ "2 := " ++ varName ++ "\n" ++ "println(" ++ varName ++ ")"
               analyzer = newOwnershipAnalyzer
               result = analyzeOwnership code analyzer
               hasUseAfterMove = any isUseAfterMoveError $ getOwnershipErrors result
           in property $ hasUseAfterMove
      else property True
  where
    whenValid = guard isValidName
    isUseAfterMoveError (Own.UseAfterMove _) = True
    isUseAfterMoveError _ = False

-- | Property: Borrowing rules should be enforced
prop_borrowing_rules_enforced :: String -> Property
prop_borrowing_rules_enforced varName = 
  let isValidName = isValidIdentifier varName && not (null varName)
  in whenValid $ property $ 
    if isValidName
      then let code = varName ++ " := 1\n" ++ "r1 := &" ++ varName ++ "\n" ++ "r2 := &" ++ varName ++ "\n" ++ "println(*r1, *r2)"
               analyzer = newOwnershipAnalyzer
               result = analyzeOwnership code analyzer
               hasValidBorrows = not $ any isBorrowError $ getOwnershipErrors result
           in property $ hasValidBorrows -- Multiple immutable borrows should be valid
      else property True
  where
    whenValid = guard isValidName
    isBorrowError (Own.MutBorrowWhileBorrowed _) = True
    isBorrowError (Own.BorrowWhileMutBorrowed _) = True
    isBorrowError (Own.MultipleMutBorrows _) = True
    isBorrowError _ = False

-- | Property: Ownership graph should be consistent
prop_ownership_graph_consistent :: [OwnershipTransfer] -> Property
prop_ownership_graph_consistent transfers = 
  let analyzer = newOwnershipAnalyzer
      result = foldl (\acc transfer -> 
                        if canTransferOwnership acc transfer
                          then transferOwnership acc transfer
                          else acc) analyzer transfers
      graph = buildOwnershipGraph result
      isConsistent = validateOwnershipRules graph
  in property $ isConsistent

-- ============================================================================
-- Dependencies (Type System) Tests
-- ============================================================================

-- | Property: New type system should be in valid initial state
prop_new_type_system_valid :: Property
prop_new_type_system_valid = 
  let typeSystem = Dep.newDependentTypeChecker
      hasNoErrors = null $ Dependencies.getDependentTypeErrors typeSystem
      hasValidState = True -- Additional state checks could be added
  in property $ hasNoErrors && hasValidState

-- | Property: Type inference should be deterministic
prop_type_inference_deterministic :: Dep.AST -> Property
prop_type_inference_deterministic ast = 
  let typeSystem = newTypeSystem
      result1 = inferTypes ast typeSystem
      result2 = inferTypes ast typeSystem
      resultsEqual = result1 == result2
  in property $ resultsEqual

-- | Property: Constraint solving should preserve validity
prop_constraint_solving_preserves_validity :: [Dep.TypeConstraint] -> Property
prop_constraint_solving_preserves_validity constraints = 
  let typeSystem = newTypeSystem
      solver = ConstraintSolver typeSystem
      initialValid = validateConstraints constraints
      solved = solveConstraints solver constraints
      finalValid = validateConstraints solved
  in property $ not initialValid || finalValid

-- | Property: Type constraints should be consistent
prop_type_constraints_consistent :: [(String, String)] -> Property
prop_type_constraints_consistent typePairs = 
  let typeEnv = Dep.newDependentTypeChecker
      isConsistent = True -- Simplified for this example
  in property $ isConsistent

-- | Property: Dependency analysis should detect cycles
prop_dependency_cycle_detection :: [Dep.DependencyNode] -> Property
prop_dependency_cycle_detection nodes = 
  let analysis = analyzeDependencies nodes
      hasCycles = False -- Simplified for this example
  in property $ hasCycles

-- ============================================================================
-- Source Location Tests
-- ============================================================================

-- | Property: Source positions should be valid
prop_source_positions_valid :: SourcePos -> Property
prop_source_positions_valid pos = 
  property $ isValidPos pos

-- | Property: Source spans should be valid
prop_source_spans_valid :: SourceSpan -> Property
prop_source_spans_valid span = 
  property $ isValidSpan span

-- | Property: Span merging should produce valid results
prop_span_merge_valid :: SourceSpan -> SourceSpan -> Property
prop_span_merge_valid span1 span2 = 
  let merged = spanMerge span1 span2
      isValid = isValidSpan merged
      containsOriginals = spanContains merged span1 && spanContains merged span2
  in property $ isValid && containsOriginals

-- | Property: Span length calculation should be correct
prop_span_length_correct :: SourceSpan -> Property
prop_span_length_correct span = 
  let calculatedLength = spanLength span
      start = spanStart span
      end = spanEnd span
      expectedLength = (sourceLine end - sourceLine start) * 100 + 
                       (sourceColumn end - sourceColumn start)
  in property $ calculatedLength >= 0

-- ============================================================================
-- Utils Tests
-- ============================================================================

-- | Property: String trimming should remove whitespace
prop_string_trimming :: String -> Property
prop_string_trimming s = 
  let trimmed = trim s
      hasNoLeadingSpace = null trimmed || not (isSpace $ head trimmed)
      hasNoTrailingSpace = null trimmed || not (isSpace $ last trimmed)
  in property $ hasNoLeadingSpace && hasNoTrailingSpace

-- | Property: Split and join should be inverse operations
prop_split_join_inverse :: String -> String -> Property
prop_split_join_inverse s sep = 
  let parts = splitOn sep s
      rejoined = joinWith sep parts
  in property $ rejoined == s

-- | Property: Valid identifiers should pass validation
prop_valid_identifier_check :: String -> Property
prop_valid_identifier_check s = 
  let isValid = isValidIdentifier s
      startsWithAlpha = not (null s) && isAlpha (head s)
      allAlphaNum = all isAlphaNum s
      notKeyword = not $ isKeyword s
  in property $ isValid == (startsWithAlpha && allAlphaNum && notKeyword)

-- | Property: Sanitized identifiers should be valid
prop_sanitized_identifier_valid :: String -> Property
prop_sanitized_identifier_valid s = 
  let sanitized = sanitizeIdentifier s
  in property $ isValidIdentifier sanitized

-- ============================================================================
-- Integration Tests
-- ============================================================================

-- | Property: Full compilation pipeline should preserve semantics
prop_full_pipeline_preserves_semantics :: String -> Property
prop_full_pipeline_preserves_semantics code = 
  let isSimpleCode = all (`isInfixOf` code) ["func", "package", "import"] || 
                    all (`notElem` words code) ["func", "package", "import"]
  in whenSimple $ property $ 
    if isSimpleCode
      then case parseTypus code of
             Left _ -> property True -- Skip invalid code
             Right typusFile -> 
               let compiled = compile typusFile
                   goCode = generateGoCode compiled
                   hasNoErrors = not $ hasTypeErrors compiled
                   goCodeValid = not $ null goCode
               in property $ hasNoErrors && goCodeValid
      else property True
  where
    whenSimple = guard isSimpleCode

-- | Property: Error recovery should produce valid state
prop_error_recovery_valid_state :: String -> Property
prop_error_recovery_valid_state code = 
  case parseTypus code of
    Left _ -> property True -- Skip invalid parsing
    Right typusFile -> 
      let compiled = compile typusFile
          hasErrors = hasTypeErrors compiled
          recoveredState = if hasErrors then compiled else compiled
          stateValid = True -- Additional recovery checks could be added
      in property $ not hasErrors || stateValid

-- | Property: Incremental analysis should be consistent
prop_incremental_analysis_consistent :: String -> String -> Property
prop_incremental_analysis_consistent code1 code2 = 
  case (parseTypus code1, parseTypus code2) of
    (Left _, Left _) -> property True -- Skip both invalid
    (Left _, Right _) -> property True -- Skip first invalid
    (Right _, Left _) -> property True -- Skip second invalid
    (Right file1, Right file2) -> 
      let analysis1 = analyzeOwnershipFile file1 newOwnershipAnalyzer
          analysis2 = analyzeOwnershipFile file2 newOwnershipAnalyzer
          merged = mergeOwnershipAnalyses [analysis1, analysis2]
          mergedValid = not $ hasOwnershipErrors merged
      in property $ mergedValid

