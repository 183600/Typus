# 超级激进内存优化配置 - 极限内存优化，保留核心测试功能
# 专为内存极度受限环境设计，确保测试不删除但最小化内存使用

# 终极内存限制（MB）- 比现有配置更激进
ULTRA_EMERGENCY_MEMORY_LIMIT=1
ULTRA_CRITICAL_MEMORY_LIMIT=2
ULTRA_MINIMAL_MEMORY_LIMIT=3
ULTRA_LOW_MEMORY_LIMIT=4
ULTRA_MODERATE_MEMORY_LIMIT=6

# 超级QuickCheck配置 - 极度最小化
ULTRA_EMERGENCY_QUICKCHECK_TESTS=1
ULTRA_CRITICAL_QUICKCHECK_TESTS=1
ULTRA_MINIMAL_QUICKCHECK_TESTS=1
ULTRA_LOW_QUICKCHECK_TESTS=1
ULTRA_MODERATE_QUICKCHECK_TESTS=1

ULTRA_EMERGENCY_QUICKCHECK_MAX_SIZE=1
ULTRA_CRITICAL_QUICKCHECK_MAX_SIZE=1
ULTRA_MINIMAL_QUICKCHECK_MAX_SIZE=1
ULTRA_LOW_QUICKCHECK_MAX_SIZE=1
ULTRA_MODERATE_QUICKCHECK_MAX_SIZE=1

ULTRA_EMERGENCY_QUICKCHECK_MAX_SHRINKS=0
ULTRA_CRITICAL_QUICKCHECK_MAX_SHRINKS=0
ULTRA_MINIMAL_QUICKCHECK_MAX_SHRINKS=0
ULTRA_LOW_QUICKCHECK_MAX_SHRINKS=0
ULTRA_MODERATE_QUICKCHECK_MAX_SHRINKS=0

# 终极GHC运行时选项 - 比现有配置更激进
ULTRA_EMERGENCY_GHCRTS="-M1m -A64k -n8k -H256k -qg -G1 -T"
ULTRA_CRITICAL_GHCRTS="-M2m -A128k -n16k -H512k -qg -G1 -T"
ULTRA_MINIMAL_GHCRTS="-M3m -A256k -n32k -H1m -qg -G1"
ULTRA_LOW_GHCRTS="-M4m -A512k -n64k -H2m -qg -G1"
ULTRA_MODERATE_GHCRTS="-M6m -A1m -n128k -H4m -qg -G1"

# 超级内存优化设置
GHC_HEAP_ALLOCATION=0.001  # 进一步减少
GHC_GC_YIELD_LIMIT=100      # 更频繁GC
GHC_GC_YIELD_LIMIT_EMERGENCY=50

# 智能测试选择 - 更精确的选择策略
ULTRA_EMERGENCY_TEST_SELECTION="ultra_essential"
ULTRA_CRITICAL_TEST_SELECTION="critical_core"
ULTRA_MINIMAL_TEST_SELECTION="essential_core"
ULTRA_LOW_TEST_SELECTION="core_basic"
ULTRA_MODERATE_TEST_SELECTION="basic_standard"

# 终极垃圾回收策略
ULTRA_EMERGENCY_GC_STRATEGY="ultra_aggressive"
ULTRA_CRITICAL_GC_STRATEGY="ultra_aggressive"
ULTRA_MINIMAL_GC_STRATEGY="very_aggressive"
ULTRA_LOW_GC_STRATEGY="aggressive"
ULTRA_MODERATE_GC_STRATEGY="frequent"

# 超短测试超时（秒）- 减少测试时间
ULTRA_EMERGENCY_TEST_TIMEOUT=15
ULTRA_CRITICAL_TEST_TIMEOUT=30
ULTRA_MINIMAL_TEST_TIMEOUT=45
ULTRA_LOW_TEST_TIMEOUT=60
ULTRA_MODERATE_TEST_TIMEOUT=90

# 高级内存监控
ENABLE_ULTRA_MEMORY_MONITORING=true
ULTRA_MEMORY_CHECK_INTERVAL=250
ULTRA_MEMORY_CLEANUP_THRESHOLD=0.7
ULTRA_EMERGENCY_CLEANUP_THRESHOLD=0.5

# 极小数据限制
ULTRA_EMERGENCY_MAX_STRING_LENGTH=1
ULTRA_CRITICAL_MAX_STRING_LENGTH=1
ULTRA_MINIMAL_MAX_STRING_LENGTH=2
ULTRA_LOW_MAX_STRING_LENGTH=3
ULTRA_MODERATE_MAX_STRING_LENGTH=4

ULTRA_EMERGENCY_MAX_LIST_LENGTH=1
ULTRA_CRITICAL_MAX_LIST_LENGTH=1
ULTRA_MINIMAL_MAX_LIST_LENGTH=1
ULTRA_LOW_MAX_LIST_LENGTH=2
ULTRA_MODERATE_MAX_LIST_LENGTH=3

ULTRA_EMERGENCY_MAX_INT_VALUE=1
ULTRA_CRITICAL_MAX_INT_VALUE=2
ULTRA_MINIMAL_MAX_INT_VALUE=3
ULTRA_LOW_MAX_INT_VALUE=5
ULTRA_MODERATE_MAX_INT_VALUE=8

# 超级测试环境变量
TYPUS_SKIP_GO_BUILD=1
TYPUS_ULTRA_MINIMAL_MODE=1
TYPUS_EMERGENCY_MODE=1
TYPUS_DISABLE_HEAVY_TESTS=1
TYPUS_ENABLE_ULTRA_OPTIMIZATION=1

# 终极构建优化
CABAL_ULTRA_BUILD_FLAGS="--flags=fast --flags=minimal"
CABAL_ULTRA_GHC_OPTIONS="-O0 -j1 -rtsopts -fno-warn-unused-imports"
CABAL_ULTRA_TEST_OPTIONS="--quickcheck-tests=1 --quickcheck-max-size=1 --quickcheck-max-shrinks=0 --test-option=--timeout=30"

# 激进临时文件清理
ULTRA_CLEANUP_TEMP_FILES=true
ULTRA_CLEANUP_CABAL_FILES=true
ULTRA_CLEANUP_GHC_FILES=true
ULTRA_CLEANUP_EVERYTHING=true

# 系统级终极优化
DROP_ALL_CACHES=true
FORCE_SYNC_FILESYSTEM=true
FORCE_GC_EVERY_SECOND=true
MINIMIZE_SWAP_USAGE=true

# 严格错误处理
FAIL_ON_ANY_MEMORY_ERROR=true
LOG_ALL_MEMORY_USAGE=true
ULTRA_VERBOSE_ERROR_OUTPUT=true
EMERGENCY_STOP_ON_ERROR=true

# 测试选择优化 - 确保只运行最关键的测试
ULTRA_ESSENTIAL_TESTS=(
    "trim_basic_property"
    "split_basic_property"
    "parser_basic_property"
    "compiler_basic_property"
    "error_handler_basic_property"
)

# 排除的大型测试文件
ULTRA_EXCLUDE_PATTERNS=(
    "*200*.hs"
    "*Comprehensive*.hs"
    "*Advanced*.hs"
    "*Extended*.hs"
    "*Enhanced*.hs"
    "*Boundary*.hs"
    "*Final*.hs"
    "*Exact*.hs"
    "*True*.hs"
)

# 优先包含的核心测试文件
ULTRA_INCLUDE_PATTERNS=(
    "*Basic*.hs"
    "*Core*.hs"
    "*Essential*.hs"
    "*MemoryOptimized*.hs"
    "*UltraMemory*.hs"
    "*Minimal*.hs"
)

# 内存使用优化策略
ULTRA_MEMORY_OPTIMIZATION_STRATEGIES=(
    "immediate_gc_after_test"
    "force_heap_compaction"
    "minimize_allocation"
    "reuse_memory_pools"
    "disable_debug_features"
    "minimal_logging"
    "compact_data_structures"
)

# 测试分组优化
ULTRA_MAX_TESTS_PER_GROUP=1
ULTRA_SEQUENTIAL_EXECUTION=true
ULTRA_NO_PARALLEL_TESTS=true
ULTRA_FORCE_SINGLE_THREAD=true