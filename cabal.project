packages: typus.cabal

program-options
  ghc-options: -Wall

-- 优化链接器选项
package *
  ghc-options: -optl-Wl,-s

-- 解决base版本冲突
constraints: indexed-traversable-instances >=0.1.1.2, base >=4.12 && <4.23, these >=1.2, indexed-traversable >=0.1.4
allow-newer: indexed-traversable-instances:base, time-compat:base, aeson:these, these:base, aeson:semialign, semialign:base, indexed-traversable:base, indexed-traversable:containers

-- 解决aeson和其他依赖的版本冲突
constraints: aeson >=2.2 && <2.3, template-haskell >=2.14.0.0 && <2.25, ghc-prim >=0.5.0.0 && <0.14, bytestring >=0.10.8.2 && <0.13, containers >=0.6.0.1 && <0.9, semialign >=1.3.1
allow-newer: aeson:template-haskell, aeson:ghc-prim, aeson:bytestring, aeson:containers, uuid-types:template-haskell, semialign:containers

-- 设置环境变量以解决locale警告
-- 注意：这些设置需要在运行测试前在shell中设置
-- export LC_ALL=C
-- export LANG=C
-- export LC_CTYPE=C
-- export LC_MESSAGES=C
-- export LC_COLLATE=C

-- 为了避免locale警告，在运行命令时使用 LC_ALL=C 前缀
