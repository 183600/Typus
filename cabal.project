packages: typus.cabal

program-options
  ghc-options: -Wall

-- 设置测试详情显示
test-show-details: direct

-- 优化链接器选项
package *
  ghc-options: -optl-Wl,-s

-- 解决base版本冲突
constraints: indexed-traversable-instances >=0.1.1.2, base >=4.12 && <4.23
allow-newer: indexed-traversable-instances:base, time-compat:base

-- 设置环境变量以解决locale警告
-- 注意：这些设置需要在运行测试前在shell中设置
-- export LC_ALL=C
-- export LANG=C
-- export LC_CTYPE=C
-- export LC_MESSAGES=C
-- export LC_COLLATE=C

-- 为了避免locale警告，在运行命令时使用 LC_ALL=C 前缀
