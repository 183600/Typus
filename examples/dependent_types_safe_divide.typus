//! dependent_types: on

package main

import "fmt"

// 精确类型定义
type NonZero = int where { self != 0 }
type Positive = int where { self > 0 }

// 安全除法函数，使用依赖类型确保除数不为零
func safeDiv(a: int, b: NonZero) -> int {
    return a / b
}

func main() {
    fmt.Println("Hello, Typus!")
    
    // 编译期验证：2 ≠ 0
    r := safeDiv(10, 2)    // ✓ 通过编译期验证
    fmt.Printf("10 / 2 = %d\n", r)
    
    // 运行时值需要使用 assert 进行类型窄化
    d := readInt()
    if d != 0 {
        r2 := safeDiv(10, d)  // ✓ 分支内 d 满足 NonZero
        fmt.Printf("10 / %d = %d\n", d, r2)
    }
    
    // 使用 assert 进行显式类型窄化
    n := readInt()
    assert n > 0             // 运行时检查，此后 n 被视为 Positive
    fmt.Printf("n is positive: %d\n", n)
}