package main

import "fmt"

// 基本类型
var (
    boolVar   bool   = true
    intVar    int    = 42
    stringVar string = "Hello, Typus!"
)

// 数组和切片
var (
    array1 [5]int = [5]int{1, 2, 3, 4, 5}
    slice1 []int = []int{1, 2, 3, 4, 5}
)

// Map
var (
    map1 = map[string]int{
        "apple":  1,
        "banana": 2,
        "cherry": 3,
    }
)

// 结构体
type Person struct {
    Name string
    Age  int
}

// 接口
type Speaker interface {
    Speak() string
}

// 实现接口
type Dog struct {
    Name string
}

func (d Dog) Speak() string {
    return "Woof!"
}

// 函数
func add(a, b int) int {
    return a + b
}

func divide(a, b int) (int, string) {
    if b == 0 {
        return 0, "division by zero"
    }
    return a / b, ""
}

func main() {
    fmt.Println("=== 综合Go语法测试 ===")
    
    // 基本类型
    fmt.Printf("boolVar: %v\n", boolVar)
    fmt.Printf("intVar: %d\n", intVar)
    fmt.Printf("stringVar: %s\n", stringVar)
    
    // 数组和切片
    fmt.Printf("array1: %v\n", array1)
    fmt.Printf("slice1: %v\n", slice1)
    
    // Map
    fmt.Printf("map1: %v\n", map1)
    
    // 结构体
    p := Person{Name: "Alice", Age: 30}
    fmt.Printf("Person: %+v\n", p)
    
    // 接口
    var s Speaker = Dog{Name: "Buddy"}
    fmt.Printf("Dog says: %s\n", s.Speak())
    
    // 函数
    sum := add(3, 4)
    fmt.Printf("add(3, 4): %d\n", sum)
    
    div, err := divide(10, 2)
    if err != "" {
        fmt.Printf("Error: %v\n", err)
    } else {
        fmt.Printf("divide(10, 2): %d\n", div)
    }
    
    fmt.Println("=== 所有测试完成 ===")
}