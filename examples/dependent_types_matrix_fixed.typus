//! dependent_types: on
package main

import "fmt"

// Matrix 类型 - 在当前实现中简化为包含维度信息的结构体
type Matrix struct {
    rows, cols int
    data       [][]int
}

// 辅助函数创建和填充矩阵
func NewMatrix(m, n int, fillValue int) Matrix {
    matData := make([][]int, m)
    for i := 0; i < m; i++ {
        matData[i] = make([]int, n)
        for j := 0; j < n; j++ {
            matData[i][j] = fillValue + (i*n+j)
        }
    }
    return Matrix{rows: m, cols: n, data: matData}
}

func main() {
    matrixA := NewMatrix(2, 3, 1)
    fmt.Printf("Matrix A (%dx%d):\n", matrixA.rows, matrixA.cols)
    for i, row := range matrixA.data {
        fmt.Printf("Row %d: %v\n", i, row)
    }

    matrixB := NewMatrix(3, 2, 5)
    fmt.Printf("\nMatrix B (%dx%d):\n", matrixB.rows, matrixB.cols)
    for i, row := range matrixB.data {
        fmt.Printf("Row %d: %v\n", i, row)
    }
}