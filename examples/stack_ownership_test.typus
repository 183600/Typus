package main

import "fmt"

// Simple Stack implementation
type Stack struct {
	elements []int
	top      int
}

func NewStack() *Stack {
	return &Stack{
		elements: make([]int, 0),
		top:      -1,
	}
}

func (s *Stack) Push(element int) {
	s.elements = append(s.elements, element)
	s.top++
}

func (s *Stack) Pop() int {
	if s.IsEmpty() {
		return 0
	}

	element := s.elements[s.top]
	s.elements = s.elements[:s.top]
	s.top--
	return element
}

func (s *Stack) Peek() int {
	if s.IsEmpty() {
		return 0
	}
	return s.elements[s.top]
}

func (s *Stack) IsEmpty() bool {
	return s.top < 0
}

func (s *Stack) Size() int {
	return s.top + 1
}

func main() {
	fmt.Println("=== Ownership Stack Tests ===")

	// Test basic stack operations
	stack := NewStack()
	fmt.Printf("Is empty? %v\n", stack.IsEmpty())
	fmt.Printf("Size: %d\n", stack.Size())
	
	stack.Push(10)
	stack.Push(20)
	stack.Push(30)
	
	fmt.Printf("After pushing 10, 20, 30:\n")
	fmt.Printf("Is empty? %v\n", stack.IsEmpty())
	fmt.Printf("Size: %d\n", stack.Size())
	fmt.Printf("Peek: %d\n", stack.Peek())
	
	fmt.Printf("Pop: %d\n", stack.Pop())
	fmt.Printf("Peek after pop: %d\n", stack.Peek())
	fmt.Printf("Size after pop: %d\n", stack.Size())
}