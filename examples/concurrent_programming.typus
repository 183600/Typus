package main

import "fmt"

// 简单的并发示例
type Counter struct {
    value int
}

func NewCounter() *Counter {
    return &Counter{value: 0}
}

func (c *Counter) Increment() {
    c.value = c.value + 1
}

func (c *Counter) Value() int {
    return c.value
}

func main() {
    fmt.Println("=== 简单并发示例 ===")
    
    counter := NewCounter()
    
    // 简单的计数器操作
    for i := 0; i < 5; i++ {
        counter.Increment()
        fmt.Printf("计数器值: %d\n", counter.Value())
    }
    
    fmt.Println("=== 并发示例完成 ===")
}