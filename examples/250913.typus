// Package main 是程序入口包。
package main

import (
	"fmt"
	"math"
)

// 常量组，支持 iota 枚举
const (
	_ = iota
	Jan
	Feb
	Mar
)

// 编译期常量表达式
const Pi = 3.14159265358979323846264338327950288419716939937510582097494459

// 变量组
var (
	x, y int
)

// 类型别名
type MyInt = int

// 新定义类型
type Celsius float64

// 结构体 + 标签 + 嵌入
type Point struct {
	X, Y float64
}

type Vertex struct {
	Point        // 匿名嵌入
	Celsius      // 多重嵌入
	name  string
	_     struct{} // 占位字段
}

// 接口：空接口与带方法的接口
type Stringer interface {
	String() string
}

type Rotator interface {
	Rotate(float64)
	Stringer // 接口嵌入
}

// 方法（值接收者）
func (v Vertex) String() string { 
	return fmt.Sprintf("Vertex{X:%.2f, Y:%.2f, Celsius:%.2f, name:%s}", v.Point.X, v.Point.Y, v.Celsius, v.name) 
}

// 方法（指针接收者）
func (p *Point) Rotate(angle float64) {
	sin, cos := math.Sincos(angle)
	p.X, p.Y = p.X*cos-p.Y*sin, p.X*sin+p.Y*cos
}

// 泛型：类型参数、约束、实例化
type Number interface {
	~int | ~float64 | ~float32
}

type Vec[T Number] []T

func (v Vec[T]) Sum() (sum T) {
	for _, x := range v {
		sum += x
	}
	return
}

// 可变参数函数
func SumInts(nums ...int) int {
	sum := 0
	for _, n := range nums {
		sum += n
	}
	return sum
}

// 多返回值 + 命名返回值
func Divide(a, b float64) (result float64, err string) {
	if b == 0 {
		err = "division by zero"
		return
	}
	result = a / b
	return
}

// 函数类型 + 匿名函数 + 闭包
type Transformer func(int) int

func Map(slice []int, fn Transformer) []int {
	out := make([]int, len(slice))
	for i, v := range slice {
		out[i] = fn(v)
	}
	return out
}

// init 函数：包初始化顺序
func init() {
	fmt.Println("init main: start")
}

func init() {
	fmt.Println("init main: second")
}

func main() {
	// 基本控制流
	fmt.Println("Hello Typus!")

	// 延迟调用
	defer fmt.Println("deferred: bye")

	// 方法调用
	var vt Vertex
	vt.Rotate(math.Pi / 2)
	fmt.Println("vt.String():", vt.String())

	// 泛型
	intVec := Vec[int]{1, 2, 3}
	fmt.Println("Vec[int].Sum():", intVec.Sum())

	// 接口转换与类型断言
	var s Stringer = vt
	fmt.Println("Stringer value:", s.String())

	// 错误处理
	_, err := Divide(1.0, 0.0)
	if err != "" {
		fmt.Println("divide error:", err)
	}

	// 测试子程序
	if SumInts(1, 2, 3) != 6 {
		fmt.Println("Test failed")
	} else {
		fmt.Println("Test passed")
	}
}