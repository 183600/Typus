package main

import "fmt"

// 基本类型
var (
	boolVar       bool = true
	intVar        int  = 42
	stringVar     string = "Hello, Typus!"
)

// 数组和切片
var (
	array1    [5]int = [5]int{1, 2, 3, 4, 5}
	slice1    []int = []int{1, 2, 3, 4, 5}
)

// Map
var (
	map1 = map[string]int{
		"apple":  1,
		"banana": 2,
		"orange": 3,
	}
)

// 结构体
type Person struct {
	Name    string
	Age     int
	Email   string
}

// 接口
type Writer interface {
	Write([]byte) (int, string)
}

// 函数
func add(a, b int) int {
	return a + b
}

func multiply(a, b float64) float64 {
	return a * b
}

func divide(a, b float64) (float64, string) {
	if b == 0 {
		return 0, "division by zero"
	}
	return a / b, ""
}

func main() {
	// 基本类型测试
	fmt.Printf("boolVar: %v\n", boolVar)
	fmt.Printf("intVar: %v\n", intVar)
	fmt.Printf("stringVar: %v\n", stringVar)

	// 数组和切片测试
	fmt.Printf("array1: %v\n", array1)
	fmt.Printf("slice1: %v\n", slice1)

	// Map测试
	fmt.Printf("map1: %v\n", map1)

	// 结构体测试
	p := Person{Name: "Alice", Age: 30, Email: "alice@example.com"}
	fmt.Printf("Person: %+v\n", p)

	// 函数测试
	sum := add(5, 3)
	fmt.Printf("add(5, 3): %d\n", sum)

	product := multiply(2.5, 4.0)
	fmt.Printf("multiply(2.5, 4.0): %.2f\n", product)

	result, err := divide(10.0, 2.0)
	if err != "" {
		fmt.Printf("Error: %s\n", err)
	} else {
		fmt.Printf("divide(10.0, 2.0): %.2f\n", result)
	}

	// 测试打印值
	fmt.Printf("Value: %v\n", 42)
	fmt.Printf("Value: %v\n", "hello")
	fmt.Printf("Value: %v\n", p)
}