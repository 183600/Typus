# Locale settings for Typus project
# This file should be sourced to avoid locale warnings

# Use universally available UTF-8 locale to avoid encoding issues
# C.utf8 is available on this Linux system and provides consistent behavior
export LC_ALL=C.utf8
export LANG=C.utf8

# Use English language for consistent output
# This avoids locale-related warnings in Haskell toolchain
export LANGUAGE=en_US:en